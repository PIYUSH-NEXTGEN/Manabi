# Copy to backend/.env and fill in. NEVER commit backend/.env.
# Docs: ../DEPLOY.md

# --- Database ---
# Local default:
DATABASE_URL=sqlite:///./app.db
# Managed Postgres (Neon/Supabase pooled endpoint). 'postgres://' is accepted and rewritten:
# DATABASE_URL=postgresql://user:pass@ep-x-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Sessions / OAuth (required for login) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Deployed: must be replaced. The app refuses to boot non-local with the placeholder.
SESSION_SECRET=change-me-long-random-string
# Public origin. Drives the GitHub OAuth callback and cookie Secure/HttpOnly flags.
# Local dev keeps the Vite proxy origin so cookies stay same-origin:
BASE_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI ---
# provider: gemini | anthropic | mock  (mock returns honest in-memory responses, good for offline dev/tests)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=

# --- Rate limits (per hour) ---
# Problem publishing per user per hour (admins exempt — they curate).
PROBLEM_CREATE_PER_HOUR=5
# Project reports per user per hour.
REPORT_RATE_LIMIT_PER_HOUR=5

# --- Admin ---
# Comma-separated GitHub logins allowed into the /admin/review page.
ADMIN_GITHUB_USERNAMES=

# --- Project submission verification ---
# Relevance (LLM) thresholds: >= VERIFY_MIN is auto-verified, < REJECT_BELOW is
# rejected at submit time, between them goes to the needs_review queue.
RELEVANCE_VERIFY_MIN=0.70
RELEVANCE_REJECT_BELOW=0.35
# Minimum contributions in the repo's contributor list for the 'contributor'
# ownership basis.
CONTRIBUTOR_MIN_COMMITS=3
# Minimum commits for the "Mark as complete" tick.
COMPLETE_MIN_COMMITS=5
# Per-user limits: concurrently active projects and submissions per 24 hours.
MAX_ACTIVE_PROJECTS_PER_USER=10
MAX_SUBMISSIONS_PER_DAY=5
# A repo older than this (days) with a below-0.85 relevance score goes to
# needs_review with a "pre-existing repository" reason.
PREEXISTING_REPO_DAYS=180
# Allow forked repositories as submissions (default: no).
ALLOW_FORK_SUBMISSIONS=false
# Minimum hours between automatic re-verification attempts of a needs_review
# project during progress refresh.
AUTO_REVERIFY_MIN_INTERVAL_HOURS=24
# Distinct user reports needed to flip a project into the needs_review queue.
REPORTS_BEFORE_REVIEW=3
