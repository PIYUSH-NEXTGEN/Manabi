# Copy to backend/.env and fill in. NEVER commit backend/.env.
# Docs: ../DEPLOY.md

# --- Database ---
# Local default:
DATABASE_URL=sqlite:///./app.db
# Managed Postgres (Neon/Supabase pooled endpoint). 'postgres://' is accepted and rewritten:
# DATABASE_URL=postgresql://user:pass@ep-x-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Sessions / OAuth (required for login) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Deployed: must be replaced. The app refuses to boot non-local with the placeholder.
SESSION_SECRET=change-me-long-random-string
# Public origin. Drives the GitHub OAuth callback and cookie Secure/HttpOnly flags.
# Local dev keeps the Vite proxy origin so cookies stay same-origin:
BASE_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI ---
# provider: gemini | anthropic | mock  (mock returns honest in-memory responses, good for offline dev/tests)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=

# --- Rate limits (per hour) ---
CHAT_RATE_LIMIT_ANON_PER_HOUR=10
CHAT_RATE_LIMIT_USER_PER_HOUR=30

# --- Crawler & admin (docs/crawler.md) ---
# Kill switch: every crawler entry point exits while false.
CRAWLER_ENABLED=false
# Required before any crawl; appears in the bot User-Agent.
CRAWLER_CONTACT=
CRAWLER_REQUIRE_POSTGRES=false
CRAWLER_MAX_REQUESTS_PER_RUN=400
CRAWLER_MAX_LLM_CALLS=200
SITE_URL=https://github.com/PIYUSH-NEXTGEN/Manabi
# Comma-separated GitHub logins allowed into /api/admin/* and /admin/review.
ADMIN_GITHUB_USERNAMES=
