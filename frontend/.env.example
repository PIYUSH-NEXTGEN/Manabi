# The frontend needs no secrets. All API calls go to relative /api/... URLs.
# Set VITE_USE_MOCKS=true to run the UI without the backend (MSW handlers).
VITE_USE_MOCKS=false

# PostHog browser analytics. These values are compiled into the public bundle.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Backend origin for a direct, cross-origin deploy. Compiled in at build time.
# Leave empty for the default setup: Pages Functions proxy /api/* to Render
# (see frontend/functions/api/[[path]].ts), FastAPI serves the built app, or
# the Vite dev proxy forwards /api to localhost:8000.
VITE_API_BASE_URL=

# Contact links. VITE_CONTACT_EMAIL defaults to manabi.build@gmail.com in
# src/lib/contact.ts; set it only to publish a different address. Both values
# are compiled into the public bundle, so treat them as public.
VITE_CONTACT_EMAIL=
VITE_GITHUB_ISSUES_URL=

# Release stamp attached to browser error reports. Cloudflare Pages injects the
# deployed commit automatically (CF_PAGES_COMMIT_SHA); set this to override it.
VITE_APP_VERSION=

# Mascot Rive animation. Leave empty to use the PNG fallback. See
# src/components/mascot/README.md for the required artboard and state machine.
VITE_MASCOT_RIVE_SRC=
