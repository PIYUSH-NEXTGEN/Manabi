# ── MANABI deployment gitignore ──
# Goal: repo contains only what deploy needs + what users should see.
# Secrets, local data, build output, caches, and internal agent notes stay out.

# ── Secrets / local env (NEVER commit) ──
backend/.env
backend/.env.local
*.pem
*.key
*.p12

# Frontend env: ignore real/local envs, keep examples + smoke build
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local
frontend/.env.*.local
frontend/.env.*
!frontend/.env.example
!frontend/.env.smoke

# ── Real dataset (private, never commit) ──
# The production projects.txt lives only on your machine (see DEPLOY.md).
# backend/tests/fixtures/projects_fixture.txt is safe + stays tracked for CI.
projects.txt
/frontend/projects.txt

# ── Internal agent / working notes (do not show to users) ──
TASKS.md
TODO.md
NOTES.md
SCRATCH.md
docs/REQUESTS.md
docs/INTERNAL*.md
docs/DRAFT*.md
agent.md
agents.md
AGENTS.md
AGENT.md
CLAUDE.md
CURSOR.md
**/agent.md
**/agents.md
**/AGENTS.md
**/AGENT.md
**/CLAUDE.md
.claude/
.cursor/
.ai/
.opencode/

# ── Duplicate / legacy deploy files (root versions are canonical) ──
# Root Procfile (sh backend/start.sh) is what Render/Railway reads.
# backend/Procfile is a leftover duplicate — never commit it.
backend/Procfile

# ── Databases (local only) ──
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
backend/app.db*
backend/*.db*

# ── Python ──
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
backend/app/seed/generated/

# ── Node / frontend build ──
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
.vite/
*.tsbuildinfo

# ── Tests / e2e artifacts ──
playwright-report/
test-results/
frontend/playwright-report/
frontend/test-results/
frontend/e2e/videos/
frontend/e2e/screenshots/
coverage/
.nyc_output/
junit*.xml
*.lcov
.vitest-cache/

# ── OS / editors ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.rej

# ── Logs / temp / local junk ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pip-log.txt
pip-delete-this-directory.txt
dump.rdb
tmp/
temp/
.cache/
.render/
.parcel-cache/
.turbo/
out/
storybook-static/
.envrc
direnv/
*.tgz
*.tar.gz

